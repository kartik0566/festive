PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5180
MONGO_URI=mongodb://127.0.0.1:27017/festive
MONGO_DB_NAME=festive
# Optional comma-separated DNS servers if Node cannot resolve Atlas SRV records.
MONGO_DNS_SERVERS=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Ollama AI proposal drafting. Install Ollama locally and pull a model such as llama3.2.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Optional: keep legacy OpenAI keys disabled unless you explicitly want to test a different provider.
OPENAI_API_KEY=
OPENAI_MODEL=

# Development admin account created automatically on server start.
ADMIN_NAME=Festive Admin
ADMIN_EMAIL=admin@festive.local
ADMIN_PASSWORD=Admin@12345

# Razorpay test/live keys. Without these, payment routes run in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Optional SMTP for inquiry notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Festive Events <hello@festive.local>
MAIL_TO=admin@festive.local
