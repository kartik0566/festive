PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5180
MONGO_URI=mongodb://127.0.0.1:27017/festive
MONGO_DB_NAME=festive
# Optional comma-separated DNS servers if Node cannot resolve Atlas SRV records.
MONGO_DNS_SERVERS=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Local Ollama for development. A Render deployment needs a hosted Ollama URL or an AI API below.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_API_KEY=

# Optional OpenAI-compatible API (can be configured with a hosted Llama provider).
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional OpenAI API fallback.
OPENAI_API_KEY=
OPENAI_MODEL=

# Development admin account created automatically on server start.
ADMIN_NAME=Festive Admin
ADMIN_EMAIL=admin@festive.local
ADMIN_PASSWORD=Admin@12345

# Razorpay test/live keys. Without these, payment routes run in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Email API works on Render Free; its sender domain must be verified with Resend.
RESEND_API_KEY=

# Optional SMTP for local development or a paid service that permits outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Festive Events <hello@festive.local>
MAIL_TO=admin@festive.local
