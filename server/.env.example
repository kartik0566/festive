PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/festive
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Development admin account created automatically on server start.
ADMIN_NAME=Festive Admin
ADMIN_EMAIL=admin@festive.local
ADMIN_PASSWORD=Admin@12345

# Razorpay test/live keys. Without these, payment routes run in demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Optional SMTP for inquiry notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Festive Events <hello@festive.local>
MAIL_TO=admin@festive.local

